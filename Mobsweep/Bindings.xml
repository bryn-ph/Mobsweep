<Bindings>
	<!-- Auto-loaded by the client. Labels (BINDING_HEADER_MOBSWEEP / BINDING_NAME_*) are set in Core/Init.lua. -->
	<!-- CLICK bindings send both key-down and key-up "clicks" to the secure button. -->
	<Binding name="CLICK MobsweepTrackerButton:LeftButton" header="MOBSWEEP" category="ADDONS"/>
	<Binding name="MOBSWEEP_TOGGLE_TRACKING" category="ADDONS">
		Mobsweep_ToggleTracking()
	</Binding>
</Bindings>
