<Bindings>
	<!-- Auto-loaded by the client. Labels (BINDING_HEADER_QUARRY / BINDING_NAME_*) are set in Core/Init.lua. -->
	<!-- CLICK bindings send both key-down and key-up "clicks" to the secure button. -->
	<Binding name="CLICK QuarryTrackerButton:LeftButton" header="QUARRY" category="ADDONS"/>
	<Binding name="QUARRY_TOGGLE_TRACKING" category="ADDONS">
		Quarry_ToggleTracking()
	</Binding>
</Bindings>
