package-as: Mobsweep

# The addon lives in Mobsweep/ so the repo root can hold tooling; lift it to the top of the package.
move-folders:
  Mobsweep/Mobsweep: Mobsweep

ignore:
  - README.md
  - LICENSE
  - CHANGELOG.md
  - CONTRIBUTING.md
  - requirements-dev.txt
  - tools
  - assets
  - tests

manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown
